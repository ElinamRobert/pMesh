# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database (Supabase Postgres — use Transaction pooler for serverless)
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.xxx:password@aws-0-region.pooler.supabase.com:5432/postgres

# Anthropic (Claude models)
ANTHROPIC_API_KEY=sk-ant-...

# Voyage AI (embeddings — get key from voyageai.com)
VOYAGE_API_KEY=pa-...

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
