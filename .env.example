# Local PostgreSQL (via docker-compose up)
DATABASE_URL="postgresql://pmesh:pmesh_dev@localhost:5432/pmesh"

# NextAuth — generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=change_me_generate_with_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:3000

# ── AI Provider ─────────────────────────────────────────────────────────────
# Set AI_PROVIDER to one of: anthropic | groq | ollama | openai
# Set LLM_MODEL to override the default for that provider (optional)
AI_PROVIDER=anthropic
# LLM_MODEL=llama-3.3-70b-versatile   # override per-provider default

# Anthropic (Claude) — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Groq (free Llama models) — https://console.groq.com
# AI_PROVIDER=groq
GROQ_API_KEY=gsk_...

# Ollama (fully local — https://ollama.com, run: ollama pull llama3.2)
# AI_PROVIDER=ollama
# LLM_MODEL=llama3.2
# OLLAMA_BASE_URL=http://localhost:11434

# OpenAI
# AI_PROVIDER=openai
OPENAI_API_KEY=sk-...

# ── Embeddings ───────────────────────────────────────────────────────────────
# Set EMBED_PROVIDER to one of: voyage | ollama | openai
EMBED_PROVIDER=voyage

# Voyage AI — https://voyageai.com
VOYAGE_API_KEY=pa-...

# Ollama embeddings (fully local — run: ollama pull nomic-embed-text)
# EMBED_PROVIDER=ollama
# EMBED_MODEL=nomic-embed-text

# OpenAI embeddings
# EMBED_PROVIDER=openai

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
