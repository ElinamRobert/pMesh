# Local PostgreSQL (via docker-compose up)
DATABASE_URL="postgresql://pmesh:pmesh_dev@localhost:5432/pmesh"

# NextAuth — generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=change_me_generate_with_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:3000

# ── AI Provider ─────────────────────────────────────────────────────────────
# Options: anthropic | groq | ollama | openai
AI_PROVIDER=groq

# Groq (free — https://console.groq.com/keys)
GROQ_API_KEY=gsk_...

# Uncomment to use Anthropic instead:
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Uncomment to use fully local Ollama (no API key needed):
# AI_PROVIDER=ollama
# LLM_MODEL=llama3.2
# OLLAMA_BASE_URL=http://localhost:11434

# ── Embeddings ───────────────────────────────────────────────────────────────
# Options: voyage | ollama | openai
EMBED_PROVIDER=ollama
EMBED_MODEL=nomic-embed-text
# OLLAMA_BASE_URL=http://localhost:11434

# Uncomment to use Voyage AI for better embedding quality:
# EMBED_PROVIDER=voyage
# VOYAGE_API_KEY=pa-...

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
